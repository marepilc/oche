{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oche",
  "version": "0.1.0",
  "identifier": "pl.mp76.oche",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Oche",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "decorations": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Keyboard-first darts scorer and practice tracker",
    "longDescription": "Oche keeps score in X01, Cricket and Around the Clock, runs practice drills (checkout, scoring, Bob's 27), stores every dart in SQLite and can sync to PostgreSQL or MySQL/MariaDB. It follows the Omarchy theme.",
    "copyright": "© 2026 Marek Pilczuk, MIT License",
    "publisher": "Marek Pilczuk",
    "homepage": "https://github.com/marepilc/oche",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
